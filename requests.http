### ==============================================================================
### V360 - PURCHASE ORDER INTEGRATION GATEWAY (TEST REQUESTS)
### ==============================================================================

@baseUrl = http://localhost:8080

### ------------------------------------------------------------------------------
### 1. AUTENTICAÇÃO: Obter Token do Cliente Alfa (ROLE_CLIENT, CLI-ALFA-001)
### ------------------------------------------------------------------------------
# @name authAlfa
POST {{baseUrl}}/api/v1/auth/token
Content-Type: application/json

{
  "clientId": "alfa-client",
  "clientSecret": "alfa-secret-123"
}

### Armazena o token na variável automaticamente
@tokenAlfa = {{authAlfa.response.body.accessToken}}


### ------------------------------------------------------------------------------
### 2. AUTENTICAÇÃO: Obter Token da Plataforma V360 (ROLE_PLATFORM)
### ------------------------------------------------------------------------------
# @name authPlatform
POST {{baseUrl}}/api/v1/auth/token
Content-Type: application/json

{
  "clientId": "v360-platform",
  "clientSecret": "platform-secret-123"
}

@tokenPlatform = {{authPlatform.response.body.accessToken}}


### ------------------------------------------------------------------------------
### 3. HEALTH CHECK: Verificar contexto autenticado (usando token da Alfa)
### ------------------------------------------------------------------------------
GET {{baseUrl}}/api/v1/health
Authorization: Bearer {{tokenAlfa}}


### ------------------------------------------------------------------------------
### 4. INGESTÃO ALFA: Ingerir carga válida de pedidos do Cliente Alfa
### ------------------------------------------------------------------------------
POST {{baseUrl}}/api/v1/ingestion/alfa
Authorization: Bearer {{tokenAlfa}}
Content-Type: application/json

{
  "purchase_orders": [
    {
      "po_number": "4500001234",
      "created_at": "2026-08-05",
      "status": "open",
      "currency": "BRL",
      "vendor": {
        "tax_id": "23456789000101",
        "name": "Metalúrgica São Jorge S.A."
      },
      "items": [
        {
          "line": 10,
          "material": "MAT-1001",
          "description": "Chapa de aço 2mm",
          "uom": "UN",
          "quantity_ordered": 100,
          "quantity_received": 60,
          "unit_price": 45.9
        },
        {
          "line": 20,
          "material": "MAT-1002",
          "description": "Perfil U 3m",
          "uom": "UN",
          "quantity_ordered": 50,
          "quantity_received": 0,
          "unit_price": 128.75
        }
      ]
    }
  ]
}


### ------------------------------------------------------------------------------
### 5. UPSERT IDEMPOTENTE: Reenviar mesmo pedido 4500001234 com status fechado
### ------------------------------------------------------------------------------
POST {{baseUrl}}/api/v1/ingestion/alfa
Authorization: Bearer {{tokenAlfa}}
Content-Type: application/json

{
  "purchase_orders": [
    {
      "po_number": "4500001234",
      "created_at": "2026-08-05",
      "status": "closed",
      "currency": "BRL",
      "vendor": {
        "tax_id": "23456789000101",
        "name": "Metalúrgica São Jorge S.A."
      },
      "items": [
        {
          "line": 10,
          "material": "MAT-1001",
          "description": "Chapa de aço 2mm",
          "uom": "UN",
          "quantity_ordered": 100,
          "quantity_received": 100,
          "unit_price": 45.9
        }
      ]
    }
  ]
}


### ------------------------------------------------------------------------------
### 6. SEGURANÇA: Tentar enviar carga da Alfa usando token de outro cliente (Beta) -> Esperado: 403 Forbidden
### ------------------------------------------------------------------------------
# @name authBeta
POST {{baseUrl}}/api/v1/auth/token
Content-Type: application/json

{
  "clientId": "beta-client",
  "clientSecret": "beta-secret-123"
}

###
@tokenBeta = {{authBeta.response.body.accessToken}}

### Tentar burlar a rota da Alfa com o token da Beta
POST {{baseUrl}}/api/v1/ingestion/alfa
Authorization: Bearer {{tokenBeta}}
Content-Type: application/json

{
  "purchase_orders": []
}


### ------------------------------------------------------------------------------
### 7. SEGURANÇA: Chamar rota protegida sem token -> Esperado: 401 Unauthorized
### ------------------------------------------------------------------------------
GET {{baseUrl}}/api/v1/health


### ------------------------------------------------------------------------------
### 8. INGESTÃO BETA: Ingerir carga do Cliente Beta via JSON bruto (headerCsv + itemsCsv)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/api/v1/ingestion/beta
Authorization: Bearer {{tokenBeta}}
Content-Type: application/json

{
  "headerCsv": "NUMERO_PEDIDO;FORNECEDOR_CNPJ;FORNECEDOR_RAZAO_SOCIAL;EMISSAO;SITUACAO;MOEDA\n20260088412;12.345.678/0001-90;Distribuidora Horizonte Ltda;15/08/2026;EM ABERTO;BRL\n20260088413;98.765.432/0001-55;Frigorífico Boa Mesa S.A.;01/08/2026;BLOQUEADO;BRL",
  "itemsCsv": "NUMERO_PEDIDO;ITEM;CODIGO_MATERIAL;DESCRICAO;UNIDADE;QTD_PEDIDA;QTD_RECEBIDA;PRECO_UNITARIO\n20260088412;1;MAT-77;Óleo de soja 900ml;UN;1.200,000;400,000;6,49\n20260088412;2;MAT-78;Açúcar refinado 1kg;UN;500,000;0,000;4,15\n20260088413;1;MAT-91;Carne bovina dianteiro kg;KG;2.000,000;0,000;27,90"
}


### ------------------------------------------------------------------------------
### 9. INGESTÃO BETA: Ingerir carga via Multipart Form (arquivos cabecalho.csv e itens.csv)
### ------------------------------------------------------------------------------
POST {{baseUrl}}/api/v1/ingestion/beta
Authorization: Bearer {{tokenBeta}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundaryBetaUpload

------WebKitFormBoundaryBetaUpload
Content-Disposition: form-data; name="headerFile"; filename="cabecalho.csv"
Content-Type: text/csv

< ./sample-data/beta/cabecalho.csv
------WebKitFormBoundaryBetaUpload
Content-Disposition: form-data; name="itemsFile"; filename="itens.csv"
Content-Type: text/csv

< ./sample-data/beta/itens.csv
------WebKitFormBoundaryBetaUpload--


### ------------------------------------------------------------------------------
### 10. UPSERT IDEMPOTENTE BETA: Atualizar pedido 20260088412 para ENCERRADO
### ------------------------------------------------------------------------------
POST {{baseUrl}}/api/v1/ingestion/beta
Authorization: Bearer {{tokenBeta}}
Content-Type: application/json

{
  "headerCsv": "NUMERO_PEDIDO;FORNECEDOR_CNPJ;FORNECEDOR_RAZAO_SOCIAL;EMISSAO;SITUACAO;MOEDA\n20260088412;12.345.678/0001-90;Distribuidora Horizonte Ltda;15/08/2026;ENCERRADO;BRL",
  "itemsCsv": "NUMERO_PEDIDO;ITEM;CODIGO_MATERIAL;DESCRICAO;UNIDADE;QTD_PEDIDA;QTD_RECEBIDA;PRECO_UNITARIO\n20260088412;1;MAT-77;Óleo de soja 900ml;UN;1.200,000;1.200,000;6,49"
}

